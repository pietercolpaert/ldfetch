# A small, hand-written RDF Message Log, used as a playground example.
#
# Each MESSAGE-delimited block below is one independent RDF Message: a
# sensor observation. The VERSION header switches the parser into RDF
# Messages mode. Blank node labels (like _:reading) are scoped per message,
# so the same label in two messages refers to two different blank nodes.
# The third message is deliberately empty, to demonstrate that empty
# messages are preserved rather than silently dropped.

VERSION "1.2-messages"
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX ex: <https://example.org/sensors#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:tempSensor1 sosa:madeObservation _:reading .
_:reading a sosa:Observation ;
  sosa:observedProperty ex:temperature ;
  sosa:hasSimpleResult "18.4"^^xsd:decimal ;
  sosa:resultTime "2026-09-05T08:00:00Z"^^xsd:dateTime .

MESSAGE

ex:tempSensor1 sosa:madeObservation _:reading .
_:reading a sosa:Observation ;
  sosa:observedProperty ex:temperature ;
  sosa:hasSimpleResult "18.6"^^xsd:decimal ;
  sosa:resultTime "2026-09-05T08:05:00Z"^^xsd:dateTime .

MESSAGE

MESSAGE

ex:tempSensor1 sosa:madeObservation _:reading .
_:reading a sosa:Observation ;
  sosa:observedProperty ex:temperature ;
  sosa:hasSimpleResult "19.1"^^xsd:decimal ;
  sosa:resultTime "2026-09-05T08:15:00Z"^^xsd:dateTime .
