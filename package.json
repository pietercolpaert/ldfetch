{
  "name": "ldfetch",
  "version": "1.3.0",
  "description": "Linked Data Fetch HTTP RDF library for Node.js and browsers",
  "type": "commonjs",
  "bin": {
    "ldfetch": "./bin/ldfetch.js"
  },
  "main": "lib/ldfetch.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node build/build.js",
    "build:playground": "node build/build-playground.js",
    "build:site": "npm run build && npm run build:playground && node build/assemble-site.js",
    "serve:playground": "npm run build:site && npx --yes http-server _site -c-1 -o"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "dist",
    "lib",
    "README.md"
  ],
  "keywords": [
    "http",
    "rdf",
    "linked",
    "data",
    "hypermedia"
  ],
  "author": "Pieter Colpaert <pieter.colpaert@ugent.be>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pietercolpaert/ldfetch.git"
  },
  "bugs": {
    "url": "https://github.com/pietercolpaert/ldfetch/issues"
  },
  "dependencies": {
    "@hapi/wreck": "^18.1.2",
    "@hpcc-js/wasm-zstd": "^1.16.0",
    "buffer": "^6.0.3",
    "commander": "^15.0.0",
    "follow-redirects": "^1.16.0",
    "https-browserify": "^1.0.0",
    "jsonld": "^9.0.0",
    "jsonld-streaming-parser": "^5.0.1",
    "microdata-rdf-streaming-parser": "^3.0.0",
    "node-cache": "^5.1.2",
    "process": "^0.11.10",
    "puppeteer-core": "^25.10.0",
    "q": "^2.0.3",
    "rdf-parser-ts": "^0.3.1",
    "rdf-writer-ts": "^0.1.1",
    "rdfa-streaming-parser": "^3.0.2",
    "rdfjs-jelly": "^0.1.4",
    "rdfxml-streaming-parser": "^3.3.0",
    "shaclc-parse": "^2.0.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4",
    "util": "^0.12.5"
  },
  "browser": {
    "./lib/NodeHttpFetcher.js": "./lib/BrowserHttpFetcher.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
